<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SimsRedux web: the game's vector fonts (Content/Fonts/*.xnb) name their reader as
    "MSDFData.FieldFontReader, MSDFData", so in the browser build that code has to live in its
    own assembly called MSDFData (like on Windows) for the engine to find it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>MSDFData</AssemblyName>
    <RootNamespace>MSDFData</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\FreeSO\Other\libs\MSDFData\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
  </ItemGroup>

</Project>
