#----------------------------- Global Properties ----------------------------#
# SimsRedux web: the game's graphics effects (shaders), built for browsers (WebGL) by KNI.
# The sources are FreeSO's; the "iOS" ones are the simpler mobile versions, which suit WebGL.

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:BlazorGL
/config:
/profile:HiDef
/compress:False

#---------------------------------- Content ---------------------------------#

#begin Web/Effects/2DWorldBatchiOS.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../../../FreeSO/TSOClient/tso.content/ContentSrc/Effects/2DWorldBatchiOS.fx;Web/Effects/2DWorldBatchiOS.fx

