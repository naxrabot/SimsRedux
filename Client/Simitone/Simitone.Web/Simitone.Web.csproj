<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    SimsRedux: the web browser version (tsr.mbrew.studio).
    It compiles the very same game source as the Windows build (FreeSO libraries + Simitone.Client)
    into one assembly, but on the KNI engine (a MonoGame-compatible engine that runs in browsers
    through WebAssembly) instead of MonoGame. The Windows projects are untouched.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Simitone.Web</RootNamespace>
    <AssemblyName>SimsRedux.Web</AssemblyName>
    <DefineConstants>$(DefineConstants);BLAZORGL;WEB</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- the game finds a lot of its code by name (reflection), which trimming would cut out -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- the game's libraries are old code; keep the warning list readable -->
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0067;CS0162;CS0108;CS0114;CS8632;CS1998;CS4014;CA1416;SYSLIB0011;SYSLIB0014;NU1701</NoWarn>
    <FSORoot>..\..\..\FreeSO\TSOClient\</FSORoot>
    <FSOLibs>..\..\..\FreeSO\Other\libs\</FSOLibs>
  </PropertyGroup>

  <!-- the web project itself -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Pages\Index.razor.cs" />
    <Compile Include="WebStartup.cs" />
    <Compile Include="BrowserFileSystem.cs" />
    <Compile Include="WebImageDecoder.cs" />
    <Compile Include="WebDebug.cs" />
    <Compile Include="GlobalUsings.cs" />
  </ItemGroup>

  <!-- the game: same files as the Windows build -->
  <ItemGroup>
    <Compile Include="$(FSORoot)tso.common\**\*.cs" />
    <Compile Include="$(FSORoot)tso.files\**\*.cs" />
    <Compile Include="$(FSORoot)tso.content\**\*.cs" />
    <Compile Include="$(FSORoot)tso.vitaboy.model\**\*.cs" />
    <Compile Include="$(FSORoot)tso.vitaboy.engine\**\*.cs" />
    <Compile Include="$(FSORoot)tso.world\**\*.cs" />
    <Compile Include="$(FSORoot)tso.sound\**\*.cs" />
    <Compile Include="$(FSORoot)tso.simantics\**\*.cs" />
    <Compile Include="$(FSORoot)FSO.UI\**\*.cs" />
    <Compile Include="$(FSOLibs)TargaImagePCL\**\*.cs" />
    <Compile Include="..\Simitone.Client\**\*.cs" />
    <!-- build output, and per-project assembly info (one assembly here) -->
    <Compile Remove="$(FSORoot)**\obj\**;$(FSORoot)**\bin\**;$(FSOLibs)**\obj\**;$(FSOLibs)**\bin\**;..\Simitone.Client\obj\**;..\Simitone.Client\bin\**" />
    <!-- Windows-only: Discord rich presence (native DLL calls browsers can't make) -->
    <Compile Remove="$(FSORoot)FSO.UI\Model\DiscordRpc.cs;$(FSORoot)FSO.UI\Model\DiscordRpcEngine.cs" />
    <Compile Remove="$(FSORoot)**\Properties\AssemblyInfo.cs;$(FSOLibs)**\Properties\AssemblyInfo.cs;..\Simitone.Client\Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- the graphics effects: KNI builds every .mgcb in this folder (Content\WebContent.mgcb) for WebGL into wwwroot/Content/Web -->

  <ItemGroup>
    <KniContentReference Include="Content\WebContent.mgcb" />
  </ItemGroup>

  <!-- Only used by the fast (ahead-of-time compiled) build, which has to trim: everything except
       .NET's own libraries is kept whole, because the game finds lots of its code by name. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="SimsRedux.Web" />
    <TrimmerRootAssembly Include="MSDFData" />
    <TrimmerRootAssembly Include="Kni.Platform" />
    <TrimmerRootAssembly Include="Xna.Framework" />
    <TrimmerRootAssembly Include="Xna.Framework.Audio" />
    <TrimmerRootAssembly Include="Xna.Framework.Content" />
    <TrimmerRootAssembly Include="Xna.Framework.Devices" />
    <TrimmerRootAssembly Include="Xna.Framework.Game" />
    <TrimmerRootAssembly Include="Xna.Framework.Graphics" />
    <TrimmerRootAssembly Include="Xna.Framework.Input" />
    <TrimmerRootAssembly Include="Xna.Framework.Media" />
    <TrimmerRootAssembly Include="Xna.Framework.Storage" />
    <TrimmerRootAssembly Include="Xna.Framework.XR" />
    <TrimmerRootAssembly Include="nkast.Wasm.Audio" />
    <TrimmerRootAssembly Include="nkast.Wasm.Canvas" />
    <TrimmerRootAssembly Include="nkast.Wasm.Dom" />
    <TrimmerRootAssembly Include="nkast.Wasm.JSInterop" />
    <TrimmerRootAssembly Include="nkast.Wasm.XHR" />
    <TrimmerRootAssembly Include="nkast.Wasm.XR" />
    <TrimmerRootAssembly Include="GOLDEngine" />
    <TrimmerRootAssembly Include="Mario" />
    <TrimmerRootAssembly Include="Mina.NET" />
    <TrimmerRootAssembly Include="MP3Sharp" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="Ninject" />
    <TrimmerRootAssembly Include="StbImageSharp" />
    <TrimmerRootAssembly Include="xxHashSharp" />
    <TrimmerRootAssembly Include="HandEvaluator" />
    <TrimmerRootAssembly Include="ICSharpCode.SharpZipLib" />
    <TrimmerRootAssembly Include="CommunityToolkit.HighPerformance" />
    <TrimmerRootAssembly Include="Common.Logging" />
    <TrimmerRootAssembly Include="Common.Logging.Core" />
    <TrimmerRootAssembly Include="DeltaQ" />
    <TrimmerRootAssembly Include="DeltaQ.BsDiff" />
  </ItemGroup>

  <!-- the vector fonts' reader, in its own MSDFData assembly so the font files can find it -->
  <ItemGroup>
    <ProjectReference Include="..\MSDFData.Web\MSDFData.Web.csproj" />
  </ItemGroup>

  <!--
    The rest of the game's own content (fonts, textures, the UI script) goes next to the website:
      wwwroot/Content/      = FreeSO's Content folder (what the Windows build ships)
      wwwroot/Content/Web/  = the graphics folder for WebGL: built effects + the OpenGL fonts/textures
  -->
  <Target Name="CopyGameContentToSite" AfterTargets="Publish">
    <PropertyGroup>
      <FSOContent>$(FSORoot)tso.content\Content\</FSOContent>
      <SiteContent>$(PublishDir)wwwroot\Content\</SiteContent>
    </PropertyGroup>
    <ItemGroup>
      <GameContent Include="$(FSOContent)**\*" Exclude="$(FSOContent)DX\**;$(FSOContent)OGL\**;$(FSOContent)iOS\**;$(FSOContent)Effects\**" />
      <!-- the rest of what the Windows build puts in its Content folder (FSO.Content.TSO, FSO.Client, Simitone.Client).
           TSO-only object replacements (262 MB) and the TSO setup picture aren't needed for The Sims 1. -->
      <TsoContent Include="$(FSORoot)FSO.Content.TSO\Content\**\*" Exclude="$(FSORoot)FSO.Content.TSO\Content\Objects\**;$(FSORoot)FSO.Content.TSO\Content\setup.png" />
      <ClientContent Include="$(FSORoot)tso.client\Content\**\*" Exclude="$(FSORoot)tso.client\Content\ArchiveCities\**" />
      <SimitoneContent Include="..\Simitone.Client\Content\**\*" />
      <GameGfxFonts Include="$(FSOContent)OGL\Fonts\**\*" />
      <GameGfxTextures Include="$(FSOContent)OGL\Textures\**\*" />
      <BuiltEffects Include="wwwroot\Content\**\*" />
    </ItemGroup>
    <Message Importance="high" Text="SimsRedux: copying game content to $(SiteContent)" />
    <Copy SourceFiles="@(GameContent)" DestinationFiles="@(GameContent->'$(SiteContent)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TsoContent)" DestinationFiles="@(TsoContent->'$(SiteContent)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ClientContent)" DestinationFiles="@(ClientContent->'$(SiteContent)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SimitoneContent)" DestinationFiles="@(SimitoneContent->'$(SiteContent)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameGfxFonts)" DestinationFiles="@(GameGfxFonts->'$(SiteContent)Web\Fonts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameGfxTextures)" DestinationFiles="@(GameGfxTextures->'$(SiteContent)Web\Textures\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BuiltEffects)" DestinationFiles="@(BuiltEffects->'$(SiteContent)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- the list of content files, so the browser can load them all at the start (js/simsfs.js) -->
    <ItemGroup>
      <SiteContentFiles Include="$(SiteContent)**\*" Exclude="$(SiteContent)files.txt" />
    </ItemGroup>
    <WriteLinesToFile File="$(SiteContent)files.txt" Lines="@(SiteContentFiles->'%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>

  <ItemGroup>
    <Reference Include="GOLDEngine">
      <HintPath>$(FSORoot)FSO.UI\Dependencies\GOLDEngine.dll</HintPath>
    </Reference>
    <Reference Include="Mario">
      <HintPath>$(FSORoot)tso.world\Mario.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.3.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.3.9001" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />

    <!-- the same helper libraries the Windows build uses -->
    <!-- pictures (the browser engine has no image decoder of its own) -->
    <PackageReference Include="StbImageSharp" Version="2.27.13" />
    <PackageReference Include="Mina" Version="2.0.12" />
    <PackageReference Include="MP3Sharp" Version="1.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Ninject" Version="3.3.6" />
    <PackageReference Include="DeltaQ" Version="2.1.0" />
    <PackageReference Include="xxHashSharp" Version="1.0.0" />
    <PackageReference Include="FreeSO.HandEvaluator" Version="1.2.0" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
  </ItemGroup>

</Project>
