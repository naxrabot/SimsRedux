<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Sims Redux dedicated server. Started and watched by the server panel (Client/Server/Panel).
       Only needs the normal .NET runtime the game already uses - no ASP.NET or other installs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SimsRedux.Server</AssemblyName>
    <RootNamespace>SimsRedux.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the panel finds the server here, whichever configuration Visual Studio built -->
    <OutputPath>..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- the game's version number (the launcher checks the website, game and server match) -->
    <Compile Include="..\..\Simitone\Simitone.Client\Utils\ReduxBuild.cs" Link="ReduxBuild.cs" />
  </ItemGroup>
</Project>
