<Project Sdk="Microsoft.NET.Sdk">
  <!-- SimsRedux: pure .NET 8 library, deliberately no NuGet packages (no System.Drawing, no XNA/MonoGame). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SimsRedux.Creator</RootNamespace>
    <AssemblyName>SimsRedux.Creator.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
